---
import { Picture } from 'astro:assets';
import scene from '../assets/batya-scene-chair.png';
import { COPY } from '../content';
---

<section class="hero" data-track-section="hero">
  <div class="hero__media">
    <Picture
      src={scene}
      alt="Тренер в кресле"
      class="hero__img"
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[480, 720, 1000, 1254]}
      sizes="(min-width: 1024px) 860px, min(100vw, 560px)"
      loading="eager"
      fetchpriority="high"
    />
    <div class="hero__shade"></div>
    <p class="hero__online">{COPY.online}</p>
  </div>

  <div class="hero__text">
    <p class="hero__label">{COPY.label}</p>
    <h1 class="hero__title" data-copy="heroTitle">{COPY.heroTitle}</h1>
    <p class="hero__secret">
      <span class="hero__secret-a">{COPY.heroSecret}</span>
    </p>
  </div>
</section>
