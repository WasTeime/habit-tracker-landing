---
import Consent from '../components/Consent.astro';
import Cta from '../components/Cta.astro';
import DemoVideo from '../components/DemoVideo.astro';
import Hero from '../components/Hero.astro';
import QrDialog from '../components/QrDialog.astro';
import Screens from '../components/Screens.astro';
import Turn from '../components/Turn.astro';
import Waitlist from '../components/Waitlist.astro';
import { CONFIG } from '../config';
import { COPY, DIRECTIONS } from '../content';
import Base from '../layouts/Base.astro';

const waitlist = CONFIG.ctaMode === 'waitlist';
---

<Base>
  <main>
    <Hero />
    <script is:inline>window.__abApply && window.__abApply();</script>

    <section class="script" id="talk" aria-label="Разговор с Тренером">
      <Turn>
        <p class="line line--first">{COPY.intro}</p>
      </Turn>

      {/* Разговор по шагам (scripts/dialog.ts): data-step скрыты до клика по кнопке */}
      <Turn who="you" class="ask" data-ask>
        <button type="button" class="chip" data-copy="askHow">{COPY.askHow}</button>
      </Turn>

      <Turn who="you" data-step tabindex="-1">
        <p class="line" data-copy="askHow">{COPY.askHow}</p>
      </Turn>

      <Turn data-step>
        <p class="line">{COPY.showDay}</p>
        <Screens />
      </Turn>

      <Turn continued data-step>
        <p class="line">{COPY.missRule}</p>
        <DemoVideo />
      </Turn>

      <Turn who="you" data-step>
        <p class="line">{COPY.askStart}</p>
      </Turn>

      <Turn body="demo" section="demo" data-step>
        <p class="line">{COPY.honestAnswer}</p>
        <div class="chips" role="group" aria-label="Что стоит на месте">
          {
            DIRECTIONS.map((d) => (
              <button type="button" class="chip" data-direction={d.id} aria-pressed="false">
                {d.label}
              </button>
            ))
          }
        </div>
      </Turn>

      <div class="demo-reply" data-demo-reply aria-live="polite"></div>
      <template id="tpl-demo-reply">
        <Turn who="you" class="anim">
          <p class="line line--picked" data-slot="label"></p>
        </Turn>
        <Turn body="reply" class="anim" data-slot="batya" hidden bodyAttrs={{ 'data-slot': 'body' }}>
          <div class="typing" data-slot="typing">
            <span class="typing__dot"></span><span class="typing__dot"></span><span class="typing__dot"></span>
            <span class="sr-only">Тренер печатает…</span>
          </div>
        </Turn>
      </template>

      <Turn continued section="cta" class="turn--cta" data-step data-after-pick>
        {waitlist ? <Waitlist /> : <Cta />}
      </Turn>
    </section>
    <script is:inline>window.__abApply && window.__abApply();</script>
  </main>

  {!waitlist && <QrDialog />}
  <Consent />

  <script>
    import '../scripts/main';
  </script>
</Base>
