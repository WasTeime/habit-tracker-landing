---
import '@fontsource/onest/400.css';
import '@fontsource/onest/700.css';
import StoreBadges from '../components/StoreBadges.astro';
import { CONFIG } from '../config';
import '../styles/global.css';

// Пока приложения нет в сторах, вести некуда — отправляем на лендинг
// (301 — чтобы статическая страница-редирект уходила сразу, а не через 2 секунды)
if (CONFIG.ctaMode === 'waitlist') return Astro.redirect('/', 301);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#111827" />
    <title>Тренер — открываю стор</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
  </head>
  <body>
    <main class="go">
      <p class="go__label">Тренер</p>
      <h1 class="go__title">
        <span class="go__wait">Открываю магазин приложений…</span>
        <span class="go__choose">Выбери свой магазин</span>
      </h1>
      <StoreBadges />
    </main>
    <script>
      import '../scripts/go';
    </script>
  </body>
</html>
