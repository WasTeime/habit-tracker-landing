# Скопировать в .env для локальной разработки. На Vercel — Settings → Environment Variables.
# Пустое значение = функция выключена. После изменения переменных на Vercel нужен редеплой.

# Адрес сайта для og:image и canonical. На Vercel можно не задавать — возьмётся домен продакшена.
PUBLIC_SITE_URL=

# Что внизу страницы: waitlist (по умолчанию) — «позови, когда выйдет»; stores — кнопки сторов
PUBLIC_CTA_MODE=waitlist

# ---------- Лист ожидания: Telegram-бот ----------
# Username бота без @ (из @BotFather) — на него ведёт главная кнопка
PUBLIC_TELEGRAM_BOT=
# Токен бота из @BotFather (секрет). Вебхук на Vercel подключится сам при продакшен-деплое
TELEGRAM_BOT_TOKEN=
# Куда слать уведомления о новых подписчиках: напиши боту /id — он ответит этим числом
TELEGRAM_ADMIN_CHAT_ID=
# Upstash Redis — тут хранятся подписчики бота. Бесплатная база с upstash.com → блок REST API:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# …или те же данные под этими именами — их сама подставляет интеграция из Vercel Marketplace
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Пароль для выгрузки /api/waitlist.csv (логин любой). Пусто — выгрузка выключена
WAITLIST_EXPORT_PASSWORD=

# ---------- Лист ожидания: запасная форма почты ----------
# 1 — показать под кнопкой бота «Нет Telegram? Оставь почту». Пусто — формы нет, /api/subscribe не принимает
PUBLIC_WAITLIST_EMAIL=
# UniSender: ключ API и id списка — заявки сразу попадают в список рассылки
UNISENDER_API_KEY=
UNISENDER_LIST_ID=

# ---------- Сторы (для PUBLIC_CTA_MODE=stores) ----------
# App Store: числовой id из apps.apple.com/app/id<ID>
PUBLIC_APPSTORE_ID=
# App Store Connect → App Analytics → Campaigns → provider token (pt)
PUBLIC_APPSTORE_PT=
# Google Play: имя пакета (ru.example.batya)
PUBLIC_GOOGLE_PLAY_ID=
# Смарт-ссылка AppsFlyer OneLink / Adjust / Branch. Пусто — используется свой /go
PUBLIC_SMART_LINK=

# ---------- Аналитика ----------
# Номер счётчика Яндекс Метрики
PUBLIC_YM_ID=
# PostHog (по желанию)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Пиксели — только те, куда реально идёт трафик
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=
PUBLIC_VK_PIXEL_ID=

# ---------- Согласие ----------
# notice — аналитика сразу, баннер только уведомляет; opt-in — ждём «Принять» (нужно для ЕС)
PUBLIC_CONSENT_MODE=notice
# Ссылка на политику обработки персональных данных (152-ФЗ)
PUBLIC_PRIVACY_URL=
