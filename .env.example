# Скопировать в .env для локальной разработки. На Vercel — Settings → Environment Variables.
# Пустое значение = функция выключена. После изменения переменных на Vercel нужен редеплой.

# Адрес сайта для og:image и canonical. На Vercel можно не задавать — возьмётся домен продакшена.
PUBLIC_SITE_URL=

# ---------- Сторы ----------
# App Store: числовой id из apps.apple.com/app/id<ID>
PUBLIC_APPSTORE_ID=
# App Store Connect → App Analytics → Campaigns → provider token (pt)
PUBLIC_APPSTORE_PT=
# Google Play: имя пакета (ru.example.batya)
PUBLIC_GOOGLE_PLAY_ID=
# Смарт-ссылка AppsFlyer OneLink / Adjust / Branch. Пусто — используется свой /go
PUBLIC_SMART_LINK=

# ---------- Аналитика ----------
# Номер счётчика Яндекс Метрики
PUBLIC_YM_ID=
# PostHog (по желанию)
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# Пиксели — только те, куда реально идёт трафик
PUBLIC_META_PIXEL_ID=
PUBLIC_TIKTOK_PIXEL_ID=
PUBLIC_VK_PIXEL_ID=

# ---------- Согласие ----------
# notice — аналитика сразу, баннер только уведомляет; opt-in — ждём «Принять» (нужно для ЕС)
PUBLIC_CONSENT_MODE=notice
# Ссылка на политику обработки персональных данных (152-ФЗ)
PUBLIC_PRIVACY_URL=
